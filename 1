html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    color: #c8ced8;
    font: 15px/1.45 "Segoe UI", system-ui, sans-serif;

    background:
        linear-gradient(rgba(0,0,0,0.60), rgba(0,0,0,0.60)),
        url("fondo.jpg");

    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}
